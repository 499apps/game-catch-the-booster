{
  "name": "catch-the-booster",
  "version": "0.1.0",
  "private": true,
  "description": "Catch the Booster: a privacy-first, offline three.js game for 499apps.com/games/catch-the-booster/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/make-icons.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci:local": "node scripts/ci-local.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
